{
    "name": "pzh",
    "version": "2.0.0",
    "private": true,
    "homepage": "https://github.com/Provincie-Zuid-Holland/Omgevingsbeleid-Frontend",
    "type": "module",
    "dependencies": {
        "@headlessui/react": "^2.2.10",
        "@pzh-ui/components": "^0.0.687",
        "@pzh-ui/css": "^0.0.118",
        "@pzh-ui/icons": "^0.0.97",
        "@pzh-ui/react": "^0.0.4",
        "@react-hookz/web": "^26.1.0",
        "@tanstack/react-query": "^5.69.0",
        "axios": "^1.15.2",
        "clsx": "^2.1.1",
        "crypto-js": "^4.2.0",
        "d3": "^7.8.5",
        "dompurify": "^3.4.1",
        "formik": "^2.4.6",
        "html-react-parser": "^6.1.7",
        "jwt-decode": "^4.0.0",
        "leaflet": "^1.9.4",
        "leaflet-draw": "^1.0.4",
        "leaflet.pattern": "^0.1.0",
        "lodash.clonedeep": "^4.5.0",
        "lodash.debounce": "^4.0.8",
        "lodash.groupby": "^4.6.0",
        "node-htmldiff": "^0.9.4",
        "proj4leaflet": "^1.0.2",
        "qs": "^6.15.3",
        "react": "19.2.7",
        "react-content-loader": "^7.1.2",
        "react-dom": "19.2.7",
        "react-error-boundary": "^6.1.1",
        "react-helmet-async": "^3.0.0",
        "react-leaflet": "^5.0.0",
        "react-router-dom": "^7.15.0",
        "uuid": "^10.0.0",
        "zod": "^3.23.8",
        "zod-formik-adapter": "^1.3.0",
        "zustand": "^5.0.0"
    },
    "scripts": {
        "build:css": "npx @tailwindcss/cli -i src/css/tailwind.src.css -o src/css/tailwind.css",
        "watch:css": "npx @tailwindcss/cli -i src/css/tailwind.src.css -o src/css/tailwind.css --watch",
        "dev": "yarn build:css && concurrently \"yarn watch:css\" \"vite\"",
        "start": "yarn dev",
        "build": "yarn build:css && tsc --noEmit && vite build",
        "preview": "vite preview",
        "serve": "yarn preview",
        "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"*.{json,md,mjs,ts}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"*.{json,md,mjs,ts}\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest",
        "test:run": "vitest run",
        "test:no-watch": "yarn test:run",
        "test:coverage": "vitest run --coverage",
        "generate-types": "orval --fail-on-warnings"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@axe-core/react": "^4.10.0",
        "@faker-js/faker": "^8.3.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/crypto-js": "^4",
        "@types/d3": "^7.4.3",
        "@types/leaflet": "^1.9.8",
        "@types/leaflet-draw": "^1.0.11",
        "@types/lodash.clonedeep": "^4.5.6",
        "@types/lodash.debounce": "^4.0.7",
        "@types/lodash.groupby": "^4.6.7",
        "@types/node": "^22.0.0",
        "@types/proj4leaflet": "^1.0.10",
        "@types/qs": "^6.15.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/uuid": "^9.0.8",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^5.0.0",
        "concurrently": "^8.2.2",
        "dotenv": "^16.4.5",
        "eslint": "^9.0.0",
        "eslint-plugin-jsx-a11y": "^6.10.0",
        "eslint-plugin-react-hooks": "^6.0.0",
        "jsdom": "^25.0.1",
        "msw": "^2.4.9",
        "orval": "^8.28.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-visualizer": "^5.11.0",
        "sass": "^1.63.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vite": "^8.2.2",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^5.0.0"
    },
    "msw": {
        "workerDirectory": "public"
    },
    "packageManager": "yarn@4.0.1"
}
